# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit it.
# `just` loads it automatically for every recipe.

# Address of the core's control API.
TELOCHE_BIND=127.0.0.1:7531

# Log filter for the core, e.g. `info`, `debug`, `teloche_api=trace`.
RUST_LOG=info

# TMDB API key (https://www.themoviedb.org/settings/api). Needed from iteration 1
# for movie and series metadata; tests never use it (external APIs are mocked).
TMDB_API_KEY=
